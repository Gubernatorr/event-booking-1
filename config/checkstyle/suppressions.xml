<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Spring створює екземпляр головного класу сам, тому private-конструктор був б помилкою -->
    <suppress checks="HideUtilityClassConstructor" files="Application\.java"/>
    <!-- Тестові методи з довгими сценаріями допустимі -->
    <suppress checks="MethodLength|ReturnCount" files="[/\\]src[/\\]test[/\\]"/>
</suppressions>
